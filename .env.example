# --- Invio form tramite procmail.sh (solo lato server, mai esposte al browser) ---
PROCMAIL_API_URL=https://api-eu.procmail.sh
PROCMAIL_API_KEY=
# Mittente su un dominio abilitato all'invio su procmail
FORM_FROM=sito@gida-spa.it
# Destinatari separati da virgola
FORM_TO=gida@gida-spa.it

# --- Cap (anti-spam, stateless) ---
# Segreto per firmare challenge e token: openssl rand -hex 32 (obbligatorio in produzione)
CAP_SECRET=

# --- Sveltia CMS: "Accedi con GitHub" (OAuth App GitHub, vedi README) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Opzionale: origin del CMS ammesse a ricevere il token (default in src/lib/server/cms-auth.ts)
# CMS_ALLOWED_ORIGINS=https://gida-sito.vercel.app,https://gida-sito-*-monema-5f86ca5f.vercel.app
