{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "dev",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "PATH=$HOME/.nvm/versions/node/v24.18.1/bin:$PATH npm run dev -- --port 5173 --strictPort"
      ],
      "port": 5173
    }
  ]
}
